---
import SitePage from '../layouts/SitePage.astro';
import Icon from '../components/Icon.astro';
import MachineShape from '../components/MachineShape.astro';
import MachineCard from '../components/MachineCard.astro';
import { getCatalog } from '../lib/catalog.js';
// Chips y fichas se generan en el build (HTML completo para buscadores); los filtros son de src/scripts/site.js.
const { categories, machines } = await getCatalog();
const count = `${machines.length} equipo${machines.length === 1 ? '' : 's'} encontrado${machines.length === 1 ? '' : 's'}`;
---
<SitePage title="Catálogo · Indecorp" description="Catálogo de maquinaria pesada Caterpillar disponible para renta." active="catalogo">
    <!-- HERO -->
    <section class="hero hero--page">
      <div class="hero-bg"></div>
      <div class="hero-machine" data-shape="loader"><MachineShape shape="loader" /></div>
      <div class="container">
        <div class="hero-content">
          <div class="breadcrumb"><a href="index.html">Inicio</a> / Catálogo</div>
          <span class="eyebrow">Flota Caterpillar®</span>
          <h1>Catálogo de<br>maquinaria pesada</h1>
          <p>Todos los equipos se entregan inspeccionados, con soporte técnico y reemplazo asegurado.</p>
        </div>
      </div>
    </section>

    <!-- CATÁLOGO (fichas generadas en el build desde src/data/machines.json) -->
    <section class="section">
      <div class="container">
        <div class="section-head reveal">
          <div><span class="eyebrow">Equipos disponibles</span><h2>Explora por categoría</h2></div>
        </div>

        <div class="catalog-toolbar">
          <div class="chips" id="chips" role="toolbar" aria-label="Filtrar por categoría"><button class="chip is-active" data-filter="all">Todos</button>{categories.map((c) => <button class="chip" data-filter={c.id}>{c.name}</button>)}</div>
          <label class="search">
            <span data-icon="search" data-size="16"><Icon name="search" size={16} /></span>
            <input id="search" type="search" placeholder="Buscar modelo (ej. 320, D6…)" aria-label="Buscar modelo">
          </label>
        </div>

        <div class="results-count" id="results-count" aria-live="polite">{count}</div>
        <div class="grid grid-3" id="catalog-grid">{machines.map((m) => <MachineCard machine={m} />)}</div>
        <div class="empty-state" id="empty-state">
          <h3>No encontramos equipos con ese criterio</h3>
          <p>Prueba con otra categoría o escríbenos: conseguimos el equipo que necesitas.</p>
          <button class="btn btn--accent" data-quote>Solicitar equipo</button>
        </div>
        <p style="font-size:.78rem;color:var(--gray-500);margin-top:28px">* Especificaciones referenciales. Validar con la ficha técnica oficial de cada modelo.</p>
      </div>
    </section>

    <!-- BENEFICIOS -->
    <section class="section section--gray">
      <div class="container grid grid-3">
        <div class="feature reveal"><div class="icon-box" data-icon="shield"><Icon name="shield" size={22} /></div><h3>Equipos inspeccionados</h3><p>Checklist técnico antes de cada entrega.</p></div>
        <div class="feature reveal delay-1"><div class="icon-box" data-icon="truck"><Icon name="truck" size={22} /></div><h3>Entrega en sitio</h3><p>Transporte con cama baja incluido en la cotización.</p></div>
        <div class="feature reveal delay-2"><div class="icon-box" data-icon="refresh"><Icon name="refresh" size={22} /></div><h3>Reemplazo asegurado</h3><p>Si un equipo falla, lo sustituimos sin costo.</p></div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-band">
      <div class="container">
        <h2>¿No encuentras el equipo que buscas?</h2>
        <div class="btns">
          <a class="btn btn--dark" href="#" data-wa><span data-icon="whatsapp" data-size="16"><Icon name="whatsapp" size={16} /></span> WhatsApp</a>
          <button class="btn btn--outline" data-quote>Cotiza ahora</button>
        </div>
      </div>
    </section>
</SitePage>
