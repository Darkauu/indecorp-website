---
/* =========================================================
   Layout base de todas las páginas: <head> común, tema claro/oscuro
   sin parpadeo, fundido de llegada entre páginas y navbar compartido.
   ========================================================= */
import Navbar from '../components/Navbar.astro';
import themeInitSource from '../shared/theme-init.js?raw';

interface Props {
  title: string;
  description: string;
  /** Enlace activo del navbar. */
  active: 'inicio' | 'nosotros' | 'catalogo' | 'servicios';
  /** Color de la barra del navegador en móviles (opcional). */
  themeColor?: string;
  /** Atributo data-page del <body> (lo usan las páginas internas). */
  pageId?: string;
}
const { title, description, active, themeColor, pageId } = Astro.props;
// Se inserta en línea y antes que nada para fijar el tema antes del primer pintado.
const themeInit = themeInitSource.replace(/^\/\*[\s\S]*?\*\/\s*/, '');
---
<!DOCTYPE html>
<html lang="es">
<head>
  <script is:inline set:html={themeInit} />
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  {themeColor && <meta name="theme-color" content={themeColor}>}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <slot name="head" />
  <script is:inline>
    // Fundido de entrada al llegar desde otra página del sitio (ver src/page-transitions.js).
    (function () { try {
      if (sessionStorage.getItem('indecorp:veil')) {
        sessionStorage.removeItem('indecorp:veil');
        var root = document.documentElement;
        root.classList.add('route-enter');
        var reveal = function () {
          requestAnimationFrame(function () { requestAnimationFrame(function () { root.classList.remove('route-enter'); }); });
        };
        document.addEventListener('DOMContentLoaded', reveal);
        setTimeout(reveal, 3000);   // salvavidas
      }
    } catch (e) {} })();
  </script>
</head>
<body data-page={pageId}>
  <slot name="before-nav" />
  <Navbar active={active} />
  <slot />
</body>
</html>
