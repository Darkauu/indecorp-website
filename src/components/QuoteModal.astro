---
/* Formulario de cotización de las páginas internas. Comportamiento: src/scripts/site.js
   (buscador de equipos: src/scripts/machine-search.js; envío: wa.me con el número de src/config.js). */
import Icon from './Icon.astro';
---
<div class="modal" id="quote-modal" role="dialog" aria-modal="true" aria-labelledby="quote-title" data-lenis-prevent><div class="modal-dialog"><button class="modal-close" aria-label="Cerrar">&times;</button><form id="quote-form"><span class="eyebrow">Cotización</span><h3 id="quote-title" style="font-size:1.5rem">Solicite su equipo</h3><p style="font-size:.9rem">Complete el formulario y lo enviaremos por WhatsApp a un asesor.</p><div class="form-row"><div class="field"><label for="q-name">Nombre</label><input id="q-name" required></div><div class="field"><label for="q-company">Empresa</label><input id="q-company"></div></div><div class="form-row"><div class="field"><label for="q-phone">Teléfono</label><input id="q-phone" type="tel" required></div><div class="field"><label for="q-email">Correo</label><input id="q-email" type="email"></div></div><div class="field machine-search"><label for="q-machine">Equipo de interés</label><div class="machine-search__box"><Icon name="search" size={16} /><input id="q-machine" type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="q-machine-list" autocomplete="off" placeholder="Busca modelo o tipo (ej. 320)"><button type="button" class="machine-search__clear" aria-label="Quitar equipo" hidden>&times;</button></div><ul id="q-machine-list" class="machine-search__list" role="listbox" aria-label="Equipos del catálogo" hidden></ul></div><div class="form-row"><div class="field"><label for="q-period">Modalidad</label><select id="q-period"><option>Por día</option><option>Por semana</option><option>Por mes</option><option>Por proyecto</option></select></div><div class="field"><label for="q-operator">Operador</label><select id="q-operator"><option>Con operador</option><option>Sin operador</option></select></div></div><div class="field"><label for="q-msg">Detalles del proyecto</label><textarea id="q-msg" rows="3"></textarea></div><button class="btn btn--accent btn--block" type="submit"><Icon name="whatsapp" size={18} /> Enviar por WhatsApp <span class="arrow"><Icon name="arrow" size={16} /></span></button></form><div class="form-success"><div class="icon-box" style="margin:0 auto 16px"><Icon name="check" size={22} /></div><h3>¡Listo! Abrimos WhatsApp</h3><p>Tu solicitud ya está escrita en el chat: solo tienes que enviarla.<br>¿No se abrió? <a class="form-success__link" target="_blank" rel="noopener">Abrir WhatsApp</a></p><button class="btn btn--outline" data-close>Cerrar</button></div></div></div>
