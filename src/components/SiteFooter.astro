---
/* Footer de las páginas internas + botón flotante de WhatsApp (el href lo pone src/scripts/site.js). */
import Icon from './Icon.astro';
import { CONFIG } from '../config.js';
import { getCategories } from '../lib/catalog.js';

const NAV = [
  { label: 'Inicio', href: 'index.html' },
  { label: 'Nosotros', href: 'nosotros.html' },
  { label: 'Catálogo', href: 'catalogo.html' },
  { label: 'Servicios', href: 'servicios.html' },
];
const categories = (await getCategories()).slice(0, 5);
const year = new Date().getFullYear();
---
<footer class="site-footer"><div class="container"><div class="footer-grid"><div><a href="index.html" class="logo"><span class="logo-mark">I</span><span>INDECORP<small>RENTA DE MAQUINARIA</small></span></a><p style="margin-top:18px">Renta de maquinaria pesada Caterpillar® con soporte técnico, operadores y transporte para su obra.</p><div class="socials"><a href="#" aria-label="Facebook">FB</a><a href="#" aria-label="Instagram">IG</a><a href="#" aria-label="LinkedIn">IN</a></div></div><div><h4>Navegación</h4><ul>{NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul></div><div><h4>Catálogo</h4><ul>{categories.map((c) => <li><a href={`catalogo.html#${c.id}`}>{c.name}</a></li>)}</ul></div><div><h4>Contacto directo</h4><ul><li style="display:flex;gap:10px"><Icon name="phone" size={16} />{CONFIG.phone}</li><li style="display:flex;gap:10px"><Icon name="whatsapp" size={16} />WhatsApp {CONFIG.whatsappDisplay}</li><li style="display:flex;gap:10px"><Icon name="mail" size={16} />{CONFIG.email}</li><li style="display:flex;gap:10px"><Icon name="pin" size={16} />Cobertura nacional</li></ul></div></div><div class="footer-bottom"><span>© {year} INDECORP — Todos los derechos reservados.</span><span>Mockup v1 · contenido de ejemplo</span></div></div></footer><a class="float-wa" href="#" data-wa aria-label="WhatsApp"><Icon name="whatsapp" size={28} /></a>
